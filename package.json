{
  "name": "to-do",
  "private": true,
  "version": "0.1.0",
  "description": "Full-featured productivity and task management platform",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev:api": "corepack pnpm --filter @todo/api dev",
    "dev:web": "corepack pnpm --filter @todo/web dev",
    "db:generate": "corepack pnpm --filter @todo/db generate",
    "db:migrate": "corepack pnpm --filter @todo/db migrate",
    "db:push": "corepack pnpm --filter @todo/db push",
    "test": "vitest run && corepack pnpm --filter @todo/api test",
    "typecheck": "tsc --noEmit && corepack pnpm --filter @todo/api typecheck && corepack pnpm --filter @todo/web exec tsc --noEmit",
    "audit": "corepack pnpm test && corepack pnpm typecheck",
    "build": "corepack pnpm --filter @todo/web build",
    "build:all": "corepack pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "dotenv": "^16.5.0"
  }
}
